# Cabeceras para los archivos públicos de Apache (Plesk).
# Las rutas de Vue y de /api las gestiona Node.js/Passenger.
# No redirigir rutas desconocidas a index.html: ocultaría las respuestas de la API.
# La fuente de ArkhamDB (/ext/arkhamdb) se sirve con un proxy de nginx,
# que se configura aparte en el panel de Plesk.

<IfModule mod_headers.c>
  # index.html siempre fresco para que se vea cada nuevo despliegue.
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>

  # Los archivos de Vite llevan hash en el nombre: se pueden cachear sin límite.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Imágenes, fichas y narraciones: sin hash en el nombre, pero cambian muy poco.
  # Un día sin preguntar y, después, una semana revalidando en segundo plano.
  <If "%{REQUEST_URI} =~ m#^/local-assets/#">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </If>
</IfModule>
