{
  "name": "@lcg/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "admin:provision": "tsx --env-file-if-exists=../../.env src/provision-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@lcg/engine": "workspace:*",
    "@lcg/shared": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.2",
    "tsx": "^4.23.15",
    "@lcg/saves": "workspace:*",
    "@lcg/cards": "workspace:*"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2"
  }
}
