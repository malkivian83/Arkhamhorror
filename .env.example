# Copiar a .env y rellenar. Nunca subir .env a git.
MYSQL_ROOT_PASSWORD=cambia-esto-root
MYSQL_USER=lcg
MYSQL_PASSWORD=cambia-esto
MYSQL_DATABASE=lcg
DATABASE_URL=mysql://lcg:cambia-esto@127.0.0.1:3306/lcg
# Optional: a separate MySQL user with DDL permissions for explicit migrations.
MIGRATION_DATABASE_URL=
SERVER_PORT=3001
SERVER_HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Arkham <noreply@example.test>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit initial administrator provisioned with pnpm --filter @lcg/server admin:provision.
# Never commit real credentials. Repeated provisioning preserves an existing admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Isolated real MySQL test database; name must end in _test.
MYSQL_TEST_URL=
